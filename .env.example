# Application
PORT=3000
NODE_ENV=development

# Database (fmp_id) - Writer
CORE_DB_WRITER_HOST=localhost
CORE_DB_WRITER_PORT=5432
CORE_DB_WRITER_NAME=fmp_id
CORE_DB_WRITER_USER=postgres
CORE_DB_WRITER_PASSWORD=postgres

# Database (fmp_id) - Reader
CORE_DB_READER_HOST=localhost
CORE_DB_READER_PORT=5432
CORE_DB_READER_NAME=fmp_id
CORE_DB_READER_USER=postgres
CORE_DB_READER_PASSWORD=postgres

# Connection Settings
CORE_DB_MAX_CONNECTIONS=20

# URL to redirect after OAuth2 callback completes (frontend callback page)
FRONTEND_CALLBACK_URL="http://localhost:5173/callback"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Hydra OAuth2 / OIDC
HYDRA_ADMIN_URL="http://localhost:4445"
HYDRA_PUBLIC_URL="http://localhost:4444"
HYDRA_CLIENT_ID=""
HYDRA_CLIENT_SECRET=""
HYDRA_REDIRECT_URI="http://localhost:3000/callback"
# Duration (in seconds) that Hydra will remember login/consent decisions
# 0 = remember forever | 3600 = 1 hour | 86400 = 1 day
HYDRA_REMEMBER_FOR=3600

# Auth
AUTH_TOKEN_IDLE_EXPIRE=60 # minute
